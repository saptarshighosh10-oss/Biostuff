   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 2. Run Phase 1\n",
    "# --entries: how many PDB antibody structures to pull\n",
    "# --variants: mutated variants to generate per sequence\n",
    "# --mutations: mutations per variant (keep <=3)\n",
    "!python pipeline.py --entries 20 --variants 5 --mutations 2"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# 3. Look at the flagged candidates\n",
    "import json\n",
    "\n",
    "with open('results/phase1_candidates.json') as f:\n",
    "    candidates = json.load(f)\n",
    "\n",
    "print(f'Total flagged for wet-lab testing: {len(candidates)}')\n",
    "print()\n",
    "\n",
    "for i, c in enumerate(candidates[:5]):\n",
    "    print(f'--- Candidate {i+1} ---')\n",
    "    print(f'  From:       {c[\"anchor_pdb\"]} chain {c[\"anchor_chain\"]} ({c[\"chain_type\"]})')\n",
    "    print(f'  Mutations:  {c[\"mutations\"]}')\n",
    "    print(f'  Risk score: {c[\"risk\"][\"combined_risk\"]:.3f}')\n",
    "    print(f'  CamSol:     {c[\"risk\"][\"camsol_score\"]:.3f}')\n",
    "    print()"
   ],
   "execution_count": null,
   "outputs": []
  },
